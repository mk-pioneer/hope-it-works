# SICP Jharkhand - Supabase Configuration
# Replace these with your project URL and anon public key from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps Platform Configuration
# Get your API key from Google Cloud Console > Google Maps Platform
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
